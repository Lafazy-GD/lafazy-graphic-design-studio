# ─────────────────────────────────────────────────────────
# Lafazy Graphic Design Studio — Environment Variables
# ─────────────────────────────────────────────────────────

# ── SUPABASE (required) ──────────────────────────────────
# These are pre-populated in the hosted environment.
# For local development, copy your project credentials from
# the Supabase dashboard: Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── EMAIL NOTIFICATIONS (optional) ────────────────────────
# Used by the notify-contact edge function to send email
# alerts when the contact form is submitted.
# Get a free API key at https://resend.com
RESEND_API_KEY=your-resend-api-key
NOTIFY_EMAIL=hello@lafazystudio.com

# ── GOOGLE ANALYTICS (optional) ───────────────────────────
# Add your GA4 measurement ID to enable analytics tracking.
# Leave blank to disable.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── ADMIN ACCESS ──────────────────────────────────────────
# The admin dashboard is protected by Supabase Auth.
# Create your admin account at /login (sign up with email/password).
# The first account created becomes the admin.
# No additional env vars needed — auth is handled by Supabase.
